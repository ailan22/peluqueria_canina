{
  "name": "peluqueria-canina",
  "compatibility_date": "2026-08-20",
  "main": "./src/index.js",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "hugo --gc --minify"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "db-turnos",
      "database_id": "b5c626dd-4a67-40d3-86fa-fff197aefca9"
    }
  ],
  "vars": {
    "OWNER_EMAIL": "contacto.pelucaninapekes@gmail.com"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peluqueria-canina",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "hugo --gc --minify"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
